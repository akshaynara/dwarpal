# Leave empty to run offline with the scripted model.
GOOGLE_API_KEY=
# Or use Vertex AI instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

DWARPAL_MODEL=gemini-flash-latest
DWARPAL_LLM_MODE=auto
# DWARPAL_MODEL_ARMOR_TEMPLATE=projects/your-project/locations/us-central1/templates/dwarpal
# DWARPAL_PUBLIC_URL=https://dwarpal-xxxx.a.run.app
# DWARPAL_DEMO=false

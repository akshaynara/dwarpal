# ---- Model ------------------------------------------------------------------
# Leave empty to run offline with the scripted model.
GOOGLE_API_KEY=
# Or Vertex AI instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1
DWARPAL_MODEL=gemini-flash-latest
DWARPAL_LLM_MODE=auto
# DWARPAL_LLM_TIMEOUT=20        # seconds before the scripted fallback answers instead of Gemini

# ---- Deployment -------------------------------------------------------------
# demo: demo identities trusted, scenario endpoints on.  production: see docs/deploy.md
DWARPAL_MODE=demo
# DWARPAL_ADMIN_TOKEN=          # required in production: protects the dashboard and admin API
# DWARPAL_IDP_KEY=              # your identity provider's key for step-up approval callbacks
# DWARPAL_CHANNEL_KEY=          # your voice platform's key for /voice/turn (generated if unset)
# DWARPAL_PUBLIC_URL=https://dwarpal-xxxx.a.run.app
# DWARPAL_DATA_DIR=/data/dwarpal
# DWARPAL_STATE=sqlite          # or memory
# DWARPAL_BUSINESSES=clinic,payor
# DWARPAL_POLICY=/config/my-business.yaml

# ---- Security layers --------------------------------------------------------
# DWARPAL_MODEL_ARMOR_TEMPLATE=projects/your-project/locations/us-central1/templates/dwarpal

# ---- Payor rails ------------------------------------------------------------
# DWARPAL_PAYOR_FHIR_URL=https://payor.example/fhir   # a real FHIR PA API; otherwise the bundled PAS server
# DWARPAL_PAYOR_FHIR_TOKEN=
